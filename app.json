{
  "expo": {
    "name": "Fervid",
    "slug": "medical-app-fresh",
    "version": "1.0.0",
    "description": "Professional Medical Presentation Platform with Cross-Device Sync",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/fervid-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihaiderj.medicalapp.dev",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ihaiderj.medicalapp.dev",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-dev-client",
      "expo-document-picker",
      "expo-image-picker",
      "expo-file-system",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:8000",
      "eas": {
        "projectId": "264174ba-9998-4c8d-ae1f-4cbcf3c52715"
      }
    }
  }
}
